{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Presupuest-Arg",
  "version": "1.0.0",
  "identifier": "ar.presupuestarg.app",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Presupuest-Arg",
        "width": 1360,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
